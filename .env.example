# Cong Facebook Graph API muon dung
GRAPH_API_VERSION=v19.0
# Chi dung de kiem thu phien ban Graph moi bang lenh npm run facebook:preflight.
# Khong tu dong thay doi production neu preflight chua dat 100% Page.
FACEBOOK_GRAPH_TEST_VERSION=

# Cong web server
PORT=3000

# --- Dang nhap Facebook (lay danh sach nhieu Page cung luc) ---
# Lay tai: developers.facebook.com/apps -> chon App -> Settings -> Basic
FB_APP_ID=
FB_APP_SECRET=

# Phai khop CHINH XAC voi "Valid OAuth Redirect URIs" cau hinh trong
# App -> Facebook Login -> Settings
FB_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

# Dat = true de tam dung moi request DANG Facebook (hang doi van duoc giu nguyen).
# Doi lai false sau khi Meta mo khoa App va da dang nhap Facebook lai.
FACEBOOK_POSTING_PAUSED=false

# Gioi han so bai Facebook moi phut. Mac dinh 1 de tranh burst request khi
# nhieu Page co cung gio dang; chi tang khi da theo doi on dinh trong vai ngay.
FACEBOOK_MAX_POSTS_PER_RUN=1

# --- Dang nhap TikTok (Content Posting API - che do Upload to Inbox, khong can audit) ---
# Lay tai: developers.tiktok.com/apps -> chon App -> Manage app -> Credentials
# Redirect URI phai khop CHINH XAC voi cau hinh trong App -> Login Kit -> Redirect URI
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# --- Canh bao khi dang bai that bai HOAC khach hang buc/phan nan gay gat (tuy chon) ---
# Cach 1 - Telegram Bot (de setup nhat, mien phi):
#   1. Chat voi @BotFather tren Telegram -> /newbot -> lay TELEGRAM_BOT_TOKEN
#   2. Chat thu 1 tin bat ky voi bot vua tao, roi mo trinh duyet vao:
#      https://api.telegram.org/bot<TOKEN>/getUpdates -> tim "chat":{"id": ...}
#      do chinh la TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cach 2 - URL webhook bat ky nhan JSON (Zalo OA, Slack, Discord...)
# Bo trong ca 2 cach neu khong can, van co canh bao trong UI + file data/canh-bao.log
WEBHOOK_URL=

# --- Bao mat (tuy chon nhung khuyen nghi bat) ---
# Dat mat khau de bat man hinh dang nhap cho toan bo web app.
# Bo trong = khong yeu cau dang nhap (chi nen dung khi may chi minh ban dung).
APP_PASSWORD=

# Khoa dung de ma hoa Access Token luu trong file (32 ky tu bat ky, giu bi mat).
# Neu doi khoa nay sau khi da co du lieu, cac token cu se khong giai ma duoc nua.
ENCRYPTION_KEY=

# Khoa dung rieng cho Content Desk (quan-ly-nick-tiktok) goi vao endpoint
# GET /api/public/tiktok-schedule de dong bo lich dang TikTok that - dat chuoi
# bat ky, giu bi mat, va dan dung gia tri nay vao CONTENT_DESK_SYNC_KEY ben
# quan-ly-nick-tiktok/.env. Bo trong = tat endpoint nay (luon tra ve 401).
CONTENT_DESK_SYNC_KEY=

# --- Tu dong tra loi binh luan bang AI (tuy chon, MAC DINH TAT) ---
# Dung Google Gemini - co goi mien phi (khong can the thanh toan de bat dau).
# Lay API key tai: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Dat = true de BAT tinh nang tu dong tra loi binh luan. De trong/false = TAT.
AUTO_REPLY_ENABLED=false
AUTO_REPLY_INTERVAL_MINUTES=60
AUTO_REPLY_LOOKBACK_DAYS=3
AUTO_REPLY_MAX_POSTS=20

# Model Gemini dung de sinh cau tra loi (gemini-flash-latest nam trong goi mien phi;
# doi sang gemini-2.5-flash-lite neu muon re/nhanh hon nua).
GEMINI_MODEL=gemini-flash-latest

# --- Inbox chung Messenger (Tin nhan) - can Webhook cong khai tu Facebook ---
# Chuoi bat ky ban tu nghi ra, dan dung y het vao o "Verify Token" khi cau hinh
# Webhooks tren Meta App Dashboard (App -> Webhooks -> Page -> Subscribe).
FB_WEBHOOK_VERIFY_TOKEN=
